# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-out.log
dev-err.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma (SQLiteのローカルDBファイル本体は除外。migrations/schemaはコミットする)
/prisma/dev.db
/prisma/dev.db-journal

# ユーザーがアップロードした写真本体はコミットしない(フォルダ構造のみ保持)
/public/uploads/*
!/public/uploads/.gitkeep
